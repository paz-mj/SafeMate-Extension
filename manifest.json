{
  "manifest_version": 3,
  "name": "SafeMate Demo",
  "version": "1.0",
  "description": "Demo de análisis de enlaces en tiempo real de SafeMate.",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "icons": {
    "16": "assets/images/logo.png",
    "48": "assets/images/logo.png",
    "128": "assets/images/logo.png"
  }
}