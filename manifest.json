{
  "manifest_version": 3,
  "name": "SafeMate Demo",
  "version": "1.1",
  "description": "Demo de análisis con Sincronización Admin.",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "*://localhost/*",
      "*://127.0.0.1/*"
    ]
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "icons": {
    "16": "assets/images/logo.png",
    "48": "assets/images/logo.png",
    "128": "assets/images/logo.png"
  }
}